		(uuid "890a4385-1e84-4f79-8781-b3312c988438")
	)
	(text "Optional I2C pull-ups (DNP)\nInterface confirmed 3.3V. Reference bus = 400Hz.\nDefault: PSU / MCU internal pull-ups.\nFit only after rise-time and USB-off loading checks."
		(exclude_from_sim no)
		(at 215.9 228.6 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8b590bc0-49fe-41b9-995b-8cc0ead5f801")
	)
	(text "USB connector ESD: data, CC and SWD/SBU\nPlace U5 at J1, with short ground returns."
		(exclude_from_sim no)
		(at 299.72 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8c448063-481e-4b5c-b81a-34987faeac0b")
	)
	(text "3V3: one 100nF per IOVDD / QSPI_IOVDD / USB_OTP_VDD / ADC_AVDD pin."
		(exclude_from_sim no)
		(at 186.69 22.86 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9bc82204-a10b-4e9a-97e3-464a3acbaa58")
	)
	(text "C24: extra 4.7uF at DVDD pin 23, away from LX / C8."
		(exclude_from_sim no)
		(at 120.65 44.45 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a621d12f-518f-4efd-835c-5155690a9db2")
	)
	(text "BOOT"
		(exclude_from_sim no)
		(at 110.49 85.852 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b00d1859-a4fa-4580-ac95-3fbd24b1cdc5")
	)
	(text "Universal Serial Bus"
		(exclude_from_sim no)
		(at 55.118 61.976 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c88de2ce-a138-4c6a-a3a3-7b502309aa5d")
	)
	(text "APW12: 2=GND, 3=SDA, 5=EN, 6=SCL\nGPIO14=SDA, GPIO15=SCL; GPIO25=MCU_PSU_ON\nGPIO25 HIGH pulls PSU_EN LOW (ON).\nPins 1/4: test pads only. No supply output on J2."
		(exclude_from_sim no)
		(at 25.4 194.31 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d0acae14-624b-4cd2-8300-e3ba3bcf0c9d")
	)
	(text "ABM8-272-T3: CL=10pF; 15pF loads; 1k damping.\nPlace C19 at LED supply pins."
		(exclude_from_sim no)
		(at 238.76 149.86 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d0ad3a8e-4afe-453a-b9b4-bcd6addf517a")
	)
	(text "RP2354A internal 1V1 regulator"
		(exclude_from_sim no)
		(at 25.4 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d56982ad-06fc-49b9-99fc-7e41eb401915")
	)
	(text "apw-meister | USB to APW12"
		(exclude_from_sim no)
		(at 35.56 158.75 0)
		(effects
			(font
				(size 1.52 1.52)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e2807e07-4fdf-4599-970a-6b2a589620e9")
	)
	(text "Core regulator layout requirements\nL1: AOTA-B201610S3R3-101-T only; white-dot end = pad 1 = 1V1.\nCopy Raspberry Pi reference placement and grounding.\nC9 = VIN bypass; C8 = local output; R14 / C23 = AVDD filter.\nKeep LX loop short; sense FB at C8 output.\nC24: extra output bypass at DVDD pin 23, away from LX.\nFirmware: use internal VREG normally; do not set VREG.HIZ."
		(exclude_from_sim no)
		(at 299.72 185.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fa03d018-5dea-46d9-8174-65fa5e6543bb")
	)
	(text "TP1 / TP2 are bare PCB pads, not assembly components."
		(exclude_from_sim no)
		(at 25.4 227.33 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fce983b1-632c-4c4e-8d70-753d71003f1b")
	)

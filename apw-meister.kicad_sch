	(text "Hold BOOT, pulse RESET / reconnect USB, release BOOT.\nWCH USB ISP; no UF2. SW2/SW3 normally DNP on bottom."
		(exclude_from_sim no)
		(at 152.4 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2b1d0c2c-2fe5-4df6-b390-bcf69544df1a")
	)
	(text "SW3 disables U4; its output discharge resets the MCU.\nF8U6 has no external reset pin. Avoid debug back-power."
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2bb6cbde-a99b-4e92-9263-424568fedf3b")
	)
	(text "Q2/Q3 block PSU pull-up backfeeding when USB is off.\nFit R10/R11 on MCU side. APW provides bus-side pull-ups.\nFirmware: 400 Hz software I2C, release pins to read.\nGPIO PA4 HIGH turns Q1 on and enables the PSU."
		(exclude_from_sim no)
		(at 266.7 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "533b6eab-1d86-4cef-9f6f-3a62313bcf19")
	)
	(text "APW12 - 3.3 V open-drain interface"
		(exclude_from_sim no)
		(at 269.24 17.78 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)

			)
			(justify left bottom)
		)
		(uuid "0259b057-c580-44d4-8c6f-c73ea0bd8931")
	)
	(text "PSU enable: GPIO25 HIGH = ON\nLOW / reset / USB power-off = release EN\nQ1 open-drain, gate held off by R13.\nPSU must pull released EN high (3.3V / OFF).\nFirmware: start low; watchdog/reset on fault."
		(exclude_from_sim no)
